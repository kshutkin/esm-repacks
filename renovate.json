{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignoreDeps": ["dayjs"],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Update release and test tooling automatically only for security fixes",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@changesets/**", "vitest", "@vitest/**"],
      "enabled": false
    }
  ]
}
